#
# Customer-owned copy of the default publish virtualhost definition, per
# https://experienceleague.adobe.com/en/docs/experience-manager-cloud-service/content/implementing/dispatcher/disp-overview#file-structure
# The original default.vhost is immutable/checksum-enforced; this copy is
# enabled instead via a symlink in conf.d/enabled_vhosts.
#

# Include customer defined variables
Include conf.d/variables/custom.vars

<VirtualHost *:80>
	ServerName	"publish"
	# Put names of which domains are used for your published site/content here
	ServerAlias	 "*"
	# Use a document root that matches the one in conf.dispatcher.d/default.farm
	DocumentRoot "${DOCROOT}"
	# URI dereferencing algorithm is applied at Sling's level, do not decode parameters here
	AllowEncodedSlashes NoDecode
	# Add header breadcrumbs for help in troubleshooting
	<IfModule mod_headers.c>
		Header add X-Vhost "publish"
	</IfModule>
	<Directory />
		<IfModule disp_apache2.c>
			# Some items cache with the wrong mime type
			# Use this option to use the name to auto-detect mime types when cached improperly
			ModMimeUsePathInfo On
			# Use this option to avoid cache poisoning
			# Sling will return /content/image.jpg as well as /content/image.jpg/ but apache can't search /content/image.jpg/ as a file
			# Apache will treat that like a directory.  This assures the last slash is never stored in cache
			DirectorySlash Off
			# Enable the dispatcher file handler for apache to fetch files from AEM
			SetHandler dispatcher-handler
		</IfModule>
		Options FollowSymLinks
		AllowOverride None
		# Insert filter
		SetOutputFilter DEFLATE
		# Don't compress images
		SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png)$ no-gzip dont-vary
		# Prevent clickjacking
		Header always append X-Frame-Options SAMEORIGIN

		# Edge Delivery Services forms integration: allow cross-origin form
		# submission requests from Universal Editor / Edge Delivery domains.
		# See https://experienceleague.adobe.com/en/docs/experience-manager-cloud-service/content/edge-delivery/build-forms/universal-editor/publish-forms
		# Note: intentionally not gated on a CORSProcessing env var set via SetEnv -
		# mod_env and mod_setenvif hook ordering is not guaranteed by directive
		# order, so a SetEnv-then-SetEnvIfExpr dependency can silently never match.

		# Local Development Environment
		SetEnvIfExpr "req_novary('Origin') =~ m#(http://localhost(:\d+)?$)#" CORSTrusted=true

		# Edge Delivery Services - Preview/Stage Environment
		SetEnvIfExpr "req_novary('Origin') =~ m#(https://.*\.aem\.page$)#" CORSTrusted=true

		# Edge Delivery Services - Production Environment
		SetEnvIfExpr "req_novary('Origin') =~ m#(https://.*\.aem\.live$)#" CORSTrusted=true

		# Adobe Demo System - custom demo domain
		SetEnvIfExpr "req_novary('Origin') =~ m#(https://.*\.adobedemosystem\.com$)#" CORSTrusted=true

		Header always set Access-Control-Allow-Origin "expr=%{req:Origin}" env=CORSTrusted
		Header always set Access-Control-Allow-Credentials "true" env=CORSTrusted
		Header always merge Vary "Origin" env=CORSTrusted
	</Directory>
	<Directory "${DOCROOT}">
		AllowOverride None
		Require all granted
	</Directory>
	<IfModule disp_apache2.c>
		# Enabled to allow rewrites to take affect and not be ignored by the dispatcher module
		DispatcherUseProcessedURL	On
		# Default setting to allow all errors to come from the aem instance
		DispatcherPassError		0
	</IfModule>
	<IfModule mod_rewrite.c>
		RewriteEngine	on
		Include conf.d/rewrites/rewrite.rules

		# Rewrite index page internally, pass through (PT)
		RewriteRule "^(/?)$" "/index.html" [PT]

	</IfModule>
</VirtualHost>
